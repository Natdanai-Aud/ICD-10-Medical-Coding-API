  "info": {
    "title": "ICD-10 Medical Coding API",
    "summary": "ICD-10 WHO 2016 lookup, hierarchy and search with Thai coding guideline case examples",
    "description": "Read-only API for hospital information systems. Dataset: ICD-10 WHO 2016 (5th edition) tabular list and alphabetical index, plus case examples from the Standard Coding Guidelines 2017 (Thailand).\n\nThe API never accepts patient data; requests contain codes or search terms only.",
    "contact": {
      "name": "ICD-10 API maintainers"
    },
    "license": {
      "name": "WHO ICD-10 copyright notice",
      "url": "https://www.who.int/classifications/icd/en/"
    },
    "version": "1.0.0"
  },
